{
  "name": "agent-video-recorder",
  "version": "0.1.0",
  "description": "Record polished demo videos of web apps from Playwright scripts, built for AI coding agents.",
  "keywords": [
    "playwright",
    "video",
    "screencast",
    "demo",
    "recording",
    "mp4",
    "ai-agents",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Dmytro Kravchenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krav4enkodm/agent-video-recorder.git"
  },
  "homepage": "https://github.com/krav4enkodm/agent-video-recorder#readme",
  "bugs": {
    "url": "https://github.com/krav4enkodm/agent-video-recorder/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "avr": "./bin/avr.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test": {
      "types": "./dist/test.d.ts",
      "require": "./dist/test.js",
      "default": "./dist/test.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.lib.tsbuildinfo",
    "!dist/**/*.d.ts.map",
    "bin",
    "README.md",
    "LICENSE",
    "docs/configuration.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -b tsconfig.lib.json && node scripts/build.mjs",
    "prepack": "pnpm build",
    "test": "jest -c jest.config.cts",
    "pretest:integration": "pnpm build",
    "test:integration": "jest -c jest.integration.config.cts",
    "test:pack": "bash scripts/smoke-pack.sh",
    "typecheck": "tsc -b",
    "avr": "node bin/avr.cjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "dependencies": {
    "commander": "^15.0.0",
    "playwright-core": "1.64.1",
    "tsx": "^4.23.11"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@swc/core": "^1.16.21",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "5.9.3"
  }
}
